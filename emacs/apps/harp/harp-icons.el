(defun harp-icon (name size &optional color description)
  "Font Awesome glyph NAME (\"solid/user\") at SIZE dp in COLOR.
DESCRIPTION names it for accessibility."
  (let ((icon (or (assoc name harp-icons) (error "Unknown Harp icon %s" name))))
    (jetpacs-design-glyph (nthcdr 3 icon) (nth 1 icon) (nth 2 icon) size
                          :color color :content-description description)))

